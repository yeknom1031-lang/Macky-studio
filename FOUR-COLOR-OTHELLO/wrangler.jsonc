{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "irodory",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-04",
  "account_id": "7e6187d98d40936d7f252d408461b19f",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "IRODORY_HUB", "class_name": "IrodoryHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IrodoryHub"] }],
  "observability": { "enabled": false }
}
